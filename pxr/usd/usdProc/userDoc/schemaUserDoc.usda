#usda 1.0
(
    "This file describes the Pixar-specific USD Geometric schemata for code generation."
    subLayers = [
        # Sublayer "parent" user doc to get user doc for inherited properties.
        @../../usdGeom/userDoc/schemaUserDoc.usda@,        
        # Sublayer domain schema.usda to get proper schema inheritance structure 
        # and property fallback values. User doc is added as overs to schema 
        # class metadata. 
        @../schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "usdProc"
        string userDocTitle = "Procedural"
    }
){
}

over GenerativeProcedural "GenerativeProcedural" (
     customData = {
        string userDocBrief = """An abstract generative procedural prim that is responsible for describing the procedural."""
        string userDoc = """An abstract generative procedural prim that is responsible for describing the procedural.
        It does not itself have any awareness or participation in the execution of the procedural but rather serves as a means of delivering a procedural's definition and input parameters.
        The value of its `proceduralSystem` property (either authored or provided by API schema fallback) indicates to which system the procedural definition is meaningful.
        
        """
    }
){

    token proceduralSystem  (
        customData = {
            string userDocBrief = """The name or convention of the system responsible for evaluating
        the procedural."""
            string userDoc = """The name or convention of the system responsible for evaluating
        the procedural.
        A default value is `hydraGenerativeProcedural`, however it's possible to create a custom procedural system by defining a new `HdGpGenerativeProceduralResolvingSceneIndex` and lableing it with a custom `TfToken`.
            """
        }
    )
}
