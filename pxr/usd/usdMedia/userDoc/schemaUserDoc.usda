#usda 1.0
(
    "This file describes the USD Media schemata for code generation."
    subLayers = [
        # Sublayer "parent" user doc to get user doc for inherited properties.
        @../../usdGeom/userDoc/schemaUserDoc.usda@,        
        # Sublayer domain schema.usda to get proper schema inheritance structure 
        # and property fallback values. User doc is added as overs to schema 
        # class metadata. 
        @../schema.usda@
    ]   
)

over "GLOBAL" (
    customData = {
        string libraryName      = "usdMedia"
        string userDocTitle     = "Media"
    }
)
{
}

over SpatialAudio "SpatialAudio" (
    customData = {
        string userDocBrief = """Brief user doc."""
        string userDoc = """Longer-form user doc."""
    }
) {
    uniform asset filePath (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    uniform token auralMode (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    uniform token playbackMode (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    uniform timecode startTime (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    uniform timecode endTime (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    uniform double mediaOffset (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
    double gain (
        customData = {
            string userDocBrief = """Brief user doc."""
            string userDoc = """Longer-form user doc."""
        }
    )
}

over "AssetPreviewsAPI" (
    customData = {
        string userDocBrief = """AssetPreviewsAPI supports providing thumbnail previews for assets."""
        string userDoc = """AssetPreviewsAPI supports providing thumbnail previews for assets.
    
Observe the example below to see how to link thumbnails to an asset.

```{code-block} usda

#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    prepend apiSchemas = ["AssetPreviewsAPI"]
    assetInfo = {
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @defaultThumbnail.jpg@
                }
                dictionary highResolution = {
                    asset defaultImage = @highResolution.jpg@
                }
                dictionary wireFrame = {
                    asset defaultImage = @wireFrame.jpg@
                }
            }
        }
    }
)
{
    def Cube "Cube"
    {
    }
}

```

Note that the `AssetPreviewsAPI` must be applied, and consider the structure of how thumbnails are assigned. Multiple thumbnails can be assigned to an asset, with one designated as the default. This allows applications to support different qualities or styles of thumbnails if desired.
"""
    }
)
{
    # no properties!
}
